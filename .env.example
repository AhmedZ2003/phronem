# Contact form delivery (src/app/api/contact/route.ts). Set ONE of the two options below
# in .env.local (development) or in the host's environment settings (production).
# With neither set, development logs submissions to the server console and production
# refuses them with an error, so no message is silently lost.

# Option 1: POST each submission as JSON to a webhook (Zapier, Make, Slack, a CRM, Formspree, ...)
CONTACT_WEBHOOK_URL=

# Option 2: email each submission through Resend (https://resend.com). The from address must be
# on a domain verified in Resend. CONTACT_TO_EMAIL may hold several addresses, comma-separated.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Operator desk (/operators). Signs operator sessions. 32+ random characters; required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPERATOR_SESSION_SECRET=

# The first operator account, created (password hashed) the first time the desk starts with no
# accounts file. After that, manage accounts with `pnpm operators` and remove the password from here.
SEED_OPERATOR_USERNAME=operator_1
SEED_OPERATOR_NAME=Operator 1
SEED_OPERATOR_PASSWORD=

# Where expert records and operator accounts are stored. Defaults to .data/ in the project.
DESK_DATA_DIR=
